# Copy to .env and fill in values ( .env is gitignored )

# Docker Hub (injected into generated repo GitHub Actions)
DOCKER_USERNAME=your-dockerhub-user
DOCKER_PASSWORD=your-dockerhub-token-or-pat

# GitHub — required for Create Product provisioning (NOT your GitHub password)
# 1. Open https://github.com/settings/tokens/new?type=beta (or Classic → Generate new token)
# 2. Scopes: repo, admin:org, workflow; authorize SSO for PaxarisGlobal if prompted
# 3. Paste the ghp_... value below
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORG=PaxarisGlobal

# Repo where Argo root manifests are committed (defaults match product-management-service)
PAXO_ORG=paxaris-global
PAXO_REPO=paxo
